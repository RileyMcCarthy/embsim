host-thread.patch: embsim host-driven mode for round-robin TCG, against
QEMU v10.1.0. With `rr_host_driven` set (target/p2/hostipc.c sets it from
the machine's `hostipc` property), QEMU's own vCPU thread parks at start-up,
before it arms its kick timer, and a host thread runs the cogs; and the
icount budget of a slice ignores real-time timers, so no wall-clock deadline
can cut a slice short. Each hunk carries the licence of the file it
modifies: accel/tcg/tcg-accel-ops-rr.c and accel/tcg/tcg-accel-ops-icount.c
are MIT (their own headers), accel/tcg/tcg-accel-ops-rr.h is
GPL-2.0-or-later (its own header). Applied by stage.sh; see README.md.

diff --git a/accel/tcg/tcg-accel-ops-icount.c b/accel/tcg/tcg-accel-ops-icount.c
index d0f7b41..5c1b527 100644
--- a/accel/tcg/tcg-accel-ops-icount.c
+++ b/accel/tcg/tcg-accel-ops-icount.c
@@ -45,10 +45,20 @@ static int64_t icount_get_limit(void)
          */
         deadline = qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
                                               QEMU_TIMER_ATTR_ALL);
-        /* Check realtime timers, because they help with input processing */
-        deadline = qemu_soonest_timeout(deadline,
-                qemu_clock_deadline_ns_all(QEMU_CLOCK_REALTIME,
-                                           QEMU_TIMER_ATTR_ALL));
+        /*
+         * Check realtime timers, because they help with input processing.
+         *
+         * embsim host-driven mode: never. The host asks for a slice of an
+         * exact instruction count, and a real-time deadline would cut it
+         * short by the wall clock, making the cogs' interleaving depend on
+         * how fast the host ran. Virtual-clock deadlines are instruction
+         * counts under -icount, and stay.
+         */
+        if (!rr_host_driven) {
+            deadline = qemu_soonest_timeout(deadline,
+                    qemu_clock_deadline_ns_all(QEMU_CLOCK_REALTIME,
+                                               QEMU_TIMER_ATTR_ALL));
+        }
 
         /*
          * Maintain prior (possibly buggy) behaviour where if no deadline
diff --git a/accel/tcg/tcg-accel-ops-rr.c b/accel/tcg/tcg-accel-ops-rr.c
index 6eec5c9..e550e0d 100644
--- a/accel/tcg/tcg-accel-ops-rr.c
+++ b/accel/tcg/tcg-accel-ops-rr.c
@@ -37,6 +37,8 @@
 #include "tcg-accel-ops-rr.h"
 #include "tcg-accel-ops-icount.h"
 
+bool rr_host_driven;
+
 /* Kick all RR vCPUs */
 void rr_kick_vcpu_thread(CPUState *unused)
 {
@@ -186,7 +188,21 @@ static void *rr_cpu_thread_fn(void *arg)
     rcu_register_thread();
     force_rcu.notify = rr_force_rcu;
     rcu_add_force_rcu_notifier(&force_rcu);
-    tcg_register_thread();
+    /*
+     * embsim host-driven mode: leave the TCG context for the HOST thread.
+     *
+     * Round-robin TCG has exactly one context. This thread is about to park
+     * at the bottom of the function and will never execute a block, so
+     * claiming the context would leave nothing for the thread that actually
+     * runs the cogs -- which is precisely the `g_assert(n < tcg_max_ctxs)`
+     * in `tcg_register_thread`.
+     *
+     * Everything else it does still runs: RCU registration and the
+     * created-signal `qemu_init` blocks on.
+     */
+    if (!rr_host_driven) {
+        tcg_register_thread();
+    }
 
     bql_lock();
     qemu_thread_get_self(cpu->thread);
@@ -207,6 +223,38 @@ static void *rr_cpu_thread_fn(void *arg)
         }
     }
 
+    /*
+     * embsim host-driven mode: hand the CPUs to the HOST thread and get out
+     * of the way.
+     *
+     * The host thread (target/p2/hostipc.c) calls cpu_exec itself, one
+     * bounded slice at a time, as embsim asks over its channel, so a slice
+     * ends exactly where embsim needs it to and no other thread runs a cog.
+     * This thread has already done everything the machine start needs --
+     * RCU registration and the created-signal qemu_init waits on -- and the
+     * only thing left is which thread calls cpu_exec.
+     *
+     * It parks BEFORE it starts the kick timer. That timer only kicks this
+     * thread's loop, which never runs; and a virtual-clock deadline caps the
+     * budget of whichever slice reaches it, while the timer re-arms from
+     * whichever thread runs it first -- the main loop's among them, on the
+     * wall clock. No timer, no cap: a slice is exactly the instructions the
+     * host asked for.
+     *
+     * Parking rather than never creating the thread keeps the change to one
+     * variable. A `TCGAccelOps.create_vcpu_thread` override is the tidier
+     * form and a separate change.
+     *
+     * The BQL must be dropped: the host slices without it, as the round-robin
+     * loop does, and a parked holder would deadlock the first slice.
+     */
+    if (rr_host_driven) {
+        bql_unlock();
+        while (1) {
+            g_usleep(1000 * 1000);
+        }
+    }
+
     rr_start_kick_timer();
 
     cpu = first_cpu;
diff --git a/accel/tcg/tcg-accel-ops-rr.h b/accel/tcg/tcg-accel-ops-rr.h
index 2a76a29..78c6791 100644
--- a/accel/tcg/tcg-accel-ops-rr.h
+++ b/accel/tcg/tcg-accel-ops-rr.h
@@ -18,4 +18,11 @@ void rr_kick_vcpu_thread(CPUState *unused);
 /* start the round robin vcpu thread */
 void rr_start_vcpu_thread(CPUState *cpu);
 
+/*
+ * embsim host-driven mode: a host thread outside the main loop runs the
+ * vCPUs, and the round-robin thread parks. Set before qemu_init; never
+ * changed after.
+ */
+extern bool rr_host_driven;
+
 #endif /* TCG_ACCEL_OPS_RR_H */
