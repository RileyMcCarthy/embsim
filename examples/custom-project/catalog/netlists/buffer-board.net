(export (version "E")
  (design
    (source "buffer-board.kicad_sch")
    (comment "An example board for examples/custom-project: the EX-BUF1 stand-in buffer behind a four-pin header. Hand-written in the shape kicad-cli sch export netlist writes."))
  (components
    (comp (ref "J1") (value "Conn_01x04")
      (libsource (lib "Connector") (part "Conn_01x04")))
    (comp (ref "U1") (value "EX-BUF1")
      (libsource (lib "example") (part "EX-BUF1")))
    (comp (ref "R1") (value "100k")
      (libsource (lib "Device") (part "R")))
    (comp (ref "R2") (value "100k")
      (libsource (lib "Device") (part "R"))))
  (nets
    (net (code "1") (name "IN")
      (node (ref "J1") (pin "1") (pinfunction "Pin_1"))
      (node (ref "U1") (pin "1") (pinfunction "A"))
      (node (ref "R1") (pin "1")))
    (net (code "2") (name "OUT")
      (node (ref "J1") (pin "2") (pinfunction "Pin_2"))
      (node (ref "U1") (pin "3") (pinfunction "Y"))
      (node (ref "R2") (pin "1")))
    (net (code "3") (name "VCC")
      (node (ref "J1") (pin "3") (pinfunction "Pin_3"))
      (node (ref "U1") (pin "4") (pinfunction "VCC")))
    (net (code "4") (name "GND")
      (node (ref "J1") (pin "4") (pinfunction "Pin_4"))
      (node (ref "U1") (pin "2") (pinfunction "GND"))
      (node (ref "R1") (pin "2"))
      (node (ref "R2") (pin "2")))))
